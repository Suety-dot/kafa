# Copia este archivo como .env.local y llena lo que vayas a usar.
# Sin ninguna variable, la aplicación corre con datos de ejemplo en memoria y sin IA.

# Clave de instalación: se pide solo para crear el primer administrador.
APP_CLAVE=
# Opcional: secreto para firmar las sesiones (si falta, se deriva de la clave de Supabase).
SESION_SECRETO=

# Supabase: Project Settings > API. La service_role solo vive en el servidor; no la compartas.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# IA: anthropic | ollama | ninguno
IA_PROVEEDOR=ninguno

# Anthropic (consola de Anthropic > API keys)
ANTHROPIC_API_KEY=
# Modelo para leer recibos y responder preguntas, y modelo para redactar el informe.
IA_MODELO_RAPIDO=claude-haiku-4-5-20251001
IA_MODELO_REDACCION=claude-sonnet-5-5

# Ollama en tu PC (gratis). Necesitas un modelo que lea imágenes.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELO=qwen2.5vl:7b
